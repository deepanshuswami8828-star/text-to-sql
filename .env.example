# Copy this file to .env and fill in your key.

# Needed to ask questions in plain English. Get a key at https://console.anthropic.com/
# Without it the app still works for browsing schemas and running your own SQL.
ANTHROPIC_API_KEY=

# ---- Optional ----

# Claude model and how hard it thinks (low | medium | high | xhigh | max)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Retry on a fallback model if the main model declines a request
# CLAUDE_FALLBACKS=true

# How many times Claude may fix a query that fails to run
# MAX_FIX_ATTEMPTS=2

# Query limits
# MAX_ROWS=1000
# QUERY_TIMEOUT_SECONDS=15
# MAX_UPLOAD_MB=50

# Connect your own databases: name=SQLAlchemy URL, separated by ";"
# Use a read-only database user. Install the driver first (pip install "psycopg[binary]" or PyMySQL).
# DATABASES=analytics=postgresql+psycopg://readonly:password@localhost:5432/analytics;shop=mysql+pymysql://readonly:password@localhost/shop

# Server address
# HOST=127.0.0.1
# PORT=8000
