# Copy this file to .env and fill in ONE of the keys below.
# Without a key the app still works for browsing schemas and running your own SQL.

# Option 1 - Claude (paid, best quality). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Option 2 - Groq (free tier with rate limits). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Used right away when the main model hits its free-tier limit (each model has its own limit)
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Which one to use: auto (Claude if its key is set, otherwise Groq) | anthropic | groq
# LLM_PROVIDER=auto

# ---- Optional ----

# Claude model and how hard it thinks (low | medium | high | xhigh | max)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Retry on a fallback model if the main model declines a request
# CLAUDE_FALLBACKS=true

# How many times the AI may fix a query that fails to run
# MAX_FIX_ATTEMPTS=3

# If the selected database doesn't have the data, answer from another database that does
# AUTO_ROUTE=true

# Query limits
# MAX_ROWS=1000
# QUERY_TIMEOUT_SECONDS=15
# MAX_UPLOAD_MB=50

# Connect your own databases: name=SQLAlchemy URL, separated by ";"
# Use a read-only database user. Install the driver first (pip install "psycopg[binary]" or PyMySQL).
# DATABASES=analytics=postgresql+psycopg://readonly:password@localhost:5432/analytics;shop=mysql+pymysql://readonly:password@localhost/shop

# Server address
# HOST=127.0.0.1
# PORT=8000
